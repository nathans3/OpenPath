{
  "name": "openpath",
  "productName": "OpenPath",
  "version": "0.1.0",
  "description": "A floating voice assistant for seniors: one tap, one clear spoken step at a time, with built-in scam protection.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "build-helper": "swiftc -O electron/native/ocr-helper.swift -o electron/native/bin/ocr-helper",
    "postinstall": "node -e \"process.platform==='darwin'&&require('child_process').execSync('npm run build-helper',{stdio:'inherit'})\" || true",
    "demo-voices": "node demo/video/build-voices.mjs",
    "demo-video": "electron demo/video/record.js",
    "demo-video-30s": "SHORT=1 electron demo/video/record.js",
    "demo-add-voice": "node demo/video/add-voice.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "org.openpath.app",
    "productName": "OpenPath",
    "files": [
      "electron/**",
      "app/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OpenPath listens only after you tap the circle, so you can ask for help out loud.",
        "NSScreenCaptureUsageDescription": "OpenPath reads your screen on this computer to know which page you are on and where to point. Nothing is saved or sent.",
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/native/bin/**"
    ],
    "npmRebuild": false
  }
}
